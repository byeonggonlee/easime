<?xml version="1.0" encoding="utf-8"?>
<!--
  easime setup (setup.exe): a WiX 5 bundle around easime.msi. Built by
  build.ps1 after the MSI; by hand:

    wix build -arch x64 -ext WixToolset.Bal.wixext -ext WixToolset.Util.wixext \
      -d Version=0.1.0 -d Msi=<easime-0.1.0-x64.msi> -d Root=<repository root> \
      -o easime-setup-0.1.0-x64.exe packaging/windows/bundle.wxs

  WHY A BUNDLE. The settings app (WinUI 3) needs Microsoft's Windows App
  Runtime. easime does not redistribute it: Microsoft's license puts duties on
  whoever does (docs/decisions.md, "설정 GUI"). So setup.exe holds only easime's
  MSI, and when the runtime is missing it downloads Microsoft's own runtime
  installer from Microsoft (download.microsoft.com, the exact file pinned by
  size and SHA-512 below: anything else is refused) and runs it before the MSI.
  Setting up easime then needs the internet only on a PC without the runtime.

  WHAT COUNTS AS "THE RUNTIME IS THERE". The machine-wide registration that
  Microsoft's 2.4 runtime installer makes (its Main package, provisioned for all
  users). A runtime that is only staged on the machine is not enough: the
  settings app then asks for the runtime (seen in CI, 2026-11-09). A PC with
  only a newer runtime channel gets the 2.4 installer as well, which leaves the
  newer runtime in place.

  REMOVING easime (Apps & features lists the bundle, not the MSI) removes the
  MSI. The runtime stays: it is Microsoft's, shared with other programs, and
  Windows lists it separately.

  The MSI runs with its defaults inside the bundle (easime switched on under
  Korean, the Japanese dictionary, no PATH entry); for the feature choices, run
  the MSI itself (packaging/windows/easime.wxs).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="easime" Manufacturer="Byeonggon Lee" Version="$(Version)"
          UpgradeCode="BE41B07C-BC3F-4ACD-A89C-D17D612B041E"
          IconSourceFile="$(Root)/data/icons/easime.ico"
          AboutUrl="https://github.com/byeonggonlee/easime">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseFile="$(Root)/packaging/windows/license.rtf"
                                              Theme="rtfLicense" />
    </BootstrapperApplication>

    <!-- Microsoft's 2.4 runtime installer provisions this package for all users. -->
    <util:RegistrySearch Id="FindWindowsAppRuntime" Variable="WindowsAppRuntimeInstalled"
                         Root="HKLM" Bitness="always64" Result="exists"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Appx\AppxAllUserStore\Applications\MicrosoftCorporationII.WinAppRuntime.Main.2_2.4.0.0_x64__8wekyb3d8bbwe" />

    <Chain>
      <ExePackage Id="WindowsAppRuntime" DisplayName="Windows App Runtime (Microsoft)"
                  Description="Microsoft's runtime for WinUI 3 apps, which the easime settings app uses"
                  PerMachine="yes" Permanent="yes" Vital="yes" Cache="remove"
                  DetectCondition="WindowsAppRuntimeInstalled" InstallArguments="--quiet">
        <!-- packaging/windows/runtime.ps1 prints these for the file behind
             https://aka.ms/windowsappsdk/2.4/latest/windowsappruntimeinstall-x64.exe
             and checks that Microsoft signed it. -->
        <ExePackagePayload Name="WindowsAppRuntimeInstall-x64.exe"
                           DownloadUrl="https://download.microsoft.com/download/097dbd99-ea76-49de-994b-eb935c72dcf1/WindowsAppRuntimeInstall-x64.exe"
                           Size="116423480"
                           Hash="AB866DA27FB6B1696C5399881F6F741BF963FF0D6DF6A8009BD2FE13AC604CADDD4FEB253CD86690E7CCDA61337880B3C911273F9A5324386B33AA512AB1363E"
                           Description="Windows App Runtime Installer" ProductName="Windows App SDK"
                           Version="2.4.0.0" />
      </ExePackage>
      <MsiPackage Id="Easime" SourceFile="$(Msi)" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
