<?xml version="1.0" encoding="utf-8"?>
<!--
  easime for Windows (MSI). Built with WiX 5 and its UI extension (build.ps1 does
  this; by hand:)

    wix build -arch x64 -ext WixToolset.UI.wixext \
      -d Version=0.1.0 -d Binaries=<dir with easime-cli.exe> -d TsfDll=<frontend_tsf.dll, built with the dll profile> \
      -d Dictionary=<mozc.bin from scripts/build-dictionary.sh mozc> -d Root=<repository root> \
      -o easime.msi packaging/windows/easime.wxs

  WHAT IT INSTALLS
    - the text service (easime_tsf.dll), registered with Windows (regsvr32) so
      the languages it offers are listed in the language settings;
    - for the user who installs it, easime's one profile (listed under Korean) is
      switched on in their language list (the "Input method" feature below), so
      nobody has to add anything by hand in Windows' settings. The features are
      the confirmation (the setup window shows them; a silent install takes the
      defaults) and uninstalling is the undo: it takes the profiles away again;
    - the Japanese dictionary (Mozc) with its license files, in "dictionary"
      next to the DLL (a feature that can be left out);
    - the terminal demo (easime-cli.exe) and the licenses.

  OTHER USERS of the same PC see the registered profiles under "Add a keyboard"
  in their language settings; only the installing user gets them switched on.

  The DLL is 64-bit: 32-bit programs cannot use the input method (docs/platforms.md).
  Everything the custom actions do is in crates/frontend-tsf (registration.rs,
  setup.rs, the exports in lib.rs).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="easime" Manufacturer="Byeonggon Lee" Version="$(Version)"
           UpgradeCode="FEE90A7B-20AC-4B9B-8D9E-DDDAFE8C7866" Scope="perMachine">
    <SummaryInformation Description="easime: Easy Eastern Asian IME (early test build of the Windows input method)" />
    <Icon Id="EasimeIcon" SourceFile="$(Root)/data/icons/easime.ico" />
    <Property Id="ARPPRODUCTICON" Value="EasimeIcon" />
    <Property Id="ARPCOMMENTS" Value="Early test build of the Windows input method (Korean). Added to the language settings of the user who installed it." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/byeonggonlee/easime" />

    <!-- A newer version replaces an older one (the old one is removed first,
         with its custom actions); installing an older one over a newer one is
         refused. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of easime is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Setup window: welcome, license, the features below, then install. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(Root)/packaging/windows/license.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="easime">
        <!-- The text service. The file is built as frontend_tsf.dll and installed
             as easime_tsf.dll, the name the custom actions and the docs use. It is
             built with the `dll` profile (panics unwind and are caught). -->
        <Component Id="TextService">
          <File Id="EasimeTsfDll" Name="easime_tsf.dll" Source="$(TsfDll)" />
        </Component>
        <Component Id="Demo">
          <File Id="EasimeCliExe" Source="$(Binaries)/easime-cli.exe" />
        </Component>
        <!-- One file per component: a component with an automatic GUID may only
             hold several files if one of them is versioned. -->
        <Component Id="AppIcon">
          <File Id="EasimeIco" Source="$(Root)/data/icons/easime.ico" />
        </Component>
        <Component Id="LicenseMit">
          <File Id="LicenseMit" Source="$(Root)/LICENSE-MIT" />
        </Component>
        <Component Id="LicenseApache">
          <File Id="LicenseApache" Source="$(Root)/LICENSE-APACHE" />
        </Component>
        <Component Id="ThirdParty">
          <File Id="ThirdParty" Source="$(Root)/THIRD_PARTY_LICENSES.md" />
        </Component>
        <!-- The Japanese dictionary (Mozc, converted by easime-dict-tool) and its
             original license files. The text service reads the "dictionary"
             folder next to its DLL, wherever the user installs easime
             (crates/frontend-tsf/src/install.rs). -->
        <Directory Id="DictionaryFolder" Name="dictionary">
          <Component Id="Dictionary">
            <File Id="MozcDictionary" Name="mozc.bin" Source="$(Dictionary)" />
          </Component>
          <Component Id="DictionaryLicense">
            <File Id="MozcLicense" Name="mozc-LICENSE.txt" Source="$(Root)/data/mozc/LICENSE" />
          </Component>
          <Component Id="DictionaryNotice">
            <File Id="MozcNotice" Name="mozc-dictionary_oss-README.txt" Source="$(Root)/data/mozc/dictionary_oss-README.txt" />
          </Component>
        </Directory>
        <!-- Only with ADDLOCAL=ALL (or ADDLOCAL=Main,AddToPath): the folder is
             added to the system PATH so `easime-cli` runs from any terminal.
             Left off by default because it changes a system setting. -->
        <Component Id="PathEntry" Guid="9C4E2C2A-6D3B-4F77-9B1A-3B5A7F0D2E41">
          <CreateFolder />
          <Environment Id="PathEasime" Name="PATH" Value="[INSTALLFOLDER]" Action="set"
                       Part="last" System="yes" Permanent="no" />
        </Component>
        <!-- A feature needs a component to be installed or not; this one only
             records that the user chose Korean. -->
        <Component Id="InputKoreanMarker">
          <RegistryKey Root="HKLM" Key="Software\easime\Input\Korean" ForceDeleteOnUninstall="yes">
            <RegistryValue Name="Chosen" Type="integer" Value="1" KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="easime" Level="1" AllowAdvertise="no" ConfigurableDirectory="INSTALLFOLDER"
             Display="expand"
             Description="The Windows input method, the terminal demo and the licenses.">
      <ComponentRef Id="TextService" />
      <ComponentRef Id="Demo" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="LicenseMit" />
      <ComponentRef Id="LicenseApache" />
      <ComponentRef Id="ThirdParty" />
      <!-- The languages to switch on in the language settings of the installing
           user. Only languages that can be typed are listed (frontend-tsf,
           profiles::TYPEABLE); Japanese and Chinese are added when they work. -->
      <Feature Id="InputKorean" Title="easime keyboard (listed under Korean)" Level="1" AllowAdvertise="no"
               Description="Adds the easime keyboard to your Windows language settings (under Korean). One key switches between English and the languages you turn on in the easime settings.">
        <ComponentRef Id="InputKoreanMarker" />
      </Feature>
      <!-- On by default; about 36 MB. Typing Japanese on Windows needs the
           candidate window, which is not there yet (docs/windows-plan-2026-11-08.md). -->
      <Feature Id="JapaneseDictionary" Title="Japanese dictionary" Level="1" AllowAdvertise="no"
               Description="Kanji conversion data for typing Japanese (the Mozc dictionary, about 36 MB). Japanese typing on Windows is not available yet.">
        <ComponentRef Id="Dictionary" />
        <ComponentRef Id="DictionaryLicense" />
        <ComponentRef Id="DictionaryNotice" />
      </Feature>
      <Feature Id="AddToPath" Title="Add easime to the PATH" Level="2" AllowAdvertise="no"
               Description="Lets you run the terminal demo (easime-cli) from any terminal.">
        <ComponentRef Id="PathEntry" />
      </Feature>
    </Feature>

    <!-- Registering the text service with Windows. Machine-wide, so as the
         system (no impersonation); a failure stops the install, and an install
         that fails later takes the registration back (rollback). -->
    <CustomAction Id="RegisterTextService" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]easime_tsf.dll&quot;" />
    <CustomAction Id="RegisterTextServiceRollback" Directory="INSTALLFOLDER" Execute="rollback" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[INSTALLFOLDER]easime_tsf.dll&quot;" />
    <!-- Removal must work even after a half-finished install, so it never fails. -->
    <CustomAction Id="UnregisterTextService" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[INSTALLFOLDER]easime_tsf.dll&quot;" />

    <!-- Switching a language on or off for the user who installs (as that user:
         the language list is theirs). rundll32 always exits with 0, so a failure
         is written to easime.log and does not stop the install; the installer's
         CI test reads the language list afterwards. -->
    <CustomAction Id="EnableKorean" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[System64Folder]rundll32.exe&quot; &quot;[INSTALLFOLDER]easime_tsf.dll&quot;,EnableForCurrentUser korean" />
    <CustomAction Id="DisableKorean" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[System64Folder]rundll32.exe&quot; &quot;[INSTALLFOLDER]easime_tsf.dll&quot;,DisableForCurrentUser korean" />

    <InstallExecuteSequence>
      <!-- Switching on and off: &Feature is what will be, !Feature what is. -->
      <Custom Action="RegisterTextServiceRollback" After="InstallFiles" Condition="&amp;Main=3" />
      <Custom Action="RegisterTextService" After="RegisterTextServiceRollback" Condition="&amp;Main=3" />
      <Custom Action="EnableKorean" After="RegisterTextService" Condition="&amp;InputKorean=3" />

      <!-- Removing: the user's language first, then Windows' registration, then the files.
           Not when a newer version is replacing this one (UPGRADINGPRODUCTCODE): it
           registers and switches on the same profile again, and taking the user's
           entry away in between would move Korean to the end of their language
           list. -->
      <Custom Action="DisableKorean" Before="UnregisterTextService" Condition="&amp;InputKorean=2 AND !InputKorean=3 AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterTextService" Before="RemoveFiles" Condition="&amp;Main=2 AND !Main=3 AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
